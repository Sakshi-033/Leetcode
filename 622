class MyCircularQueue {
    private final int[] q;
    private final int size;
    private int front;
    private int rear;
    private int count;




    public MyCircularQueue(int k) {
        this.size = k;
        this.q = new int[k];
        this.front = 0;
        this.rear = 0;
        this.count = 0;
        

        
    }
    
    public boolean enQueue(int value) {

        if(count == size){
            return false;
        }
        q[rear] = value;
        rear = (rear+1)%size;
        count++;
        return true;



        
    }
    
    public boolean deQueue() {

        if(count == 0){
            return false;
        }
        front = (front+1)%size;
        count--;
        return true;
        
    }
    
    public int Front() {
        if(count == 0){
            return -1;
        }
        return q[front];
        
    }
    
    public int Rear() {
        if(count == 0){
            return -1;
        }
        return q[(rear-1+size)%size];
        
    }
    
    public boolean isEmpty() {
        if(count == 0){
            return true;
        }
        else{
            return false;
        }
        
    }
    
    public boolean isFull() {
        if(count == size){
            return true;
        }
        else{
            return false;
        }
        
    }
}

