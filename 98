/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */

class Solution {
    public int check(TreeNode root, long min, long max) {
        if (root == null) return 1;

        if (root.val <= min || root.val >= max) {
            return 0;
        }

        int left = check(root.left, min, root.val);
        int right = check(root.right, root.val, max);

        if (left == 1 && right == 1) {
            return 1;
        } else {
            return 0;
        }
    }

    public boolean isValidBST(TreeNode root) {
        return check(root, Long.MIN_VALUE, Long.MAX_VALUE) == 1;
    }
}
