class Solution {
    public int[] shuffle(int[] nums, int n) {
        int m = nums.length;
        int[] arr = new int[m];
        int j = n;
        int k = 0;
        for(int i= 0;i<n;i = i+1){
            arr[k] = nums[i];
            arr[k+1] = nums[j];
            j++;
            k = k+2;


        }
        return arr ;

        
    }
}
