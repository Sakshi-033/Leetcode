class Solution {
    public int a(int index, int[] nums, int[] dp) {
        if (index < 0) {
            return 0;
        }
        if (index == 0) {
            return nums[0];
        }
       
        if (dp[index] != -1) {
            return dp[index];
        }

        int not_take = a(index - 1, nums, dp);
        int take = nums[index] + a(index - 2, nums, dp); 

       
        return dp[index] = Math.max(not_take, take);
    }

    public int rob(int[] nums) {
        int n = nums.length;
        int[] dp = new int[n];
        Arrays.fill(dp, -1);
        
        
        return a(n - 1, nums, dp);
    }
}
