class Solution {
    public String largestEven(String s) {
        int n = s.length();
        for (int i = n - 1 ; i >= 0; i--) {
            if (s.charAt(i) == '2') {
                return s;
            }
            if(s.charAt(i) != '2') {
                s = new StringBuilder(s).deleteCharAt(i).toString();
            }

        }
        return s;

    }
}
