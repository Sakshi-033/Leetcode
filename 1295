class Solution {
    public int findNumbers(int[] nums) {
        int m = nums.length;
        int k = 1;
 
        int a =0 ;
        int count = 0;
        for(int i : nums){
            int s = 0;
            while(i>0){

                s++;
                i= i/10;

                
            }
            if(s%2==0){
                count++;
            }
        }
        return count;
        
    }
}
