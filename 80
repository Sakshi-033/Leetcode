import java.util.Arrays;

class Solution {
    public int removeDuplicates(int[] nums) {
        int ans = 0;

        for (int i = 0; i < nums.length - 1 - ans; i++) {
            int s = i + 1;
            int e = nums.length - 1 - ans;
            int count = 1;

            while (s <= e) {
                if (nums[i] == nums[s]) {
                    count++;

                    if (count > 2) {

                        int temp = nums[s];
                        nums[s] = nums[e];
                        nums[e] = temp;

                        ans++;
                        e--;
                       
                        count--; 
                    } else {
                        s++;
                    }
                } else {
                    s++;
                    
                }
            }
        }

       
        Arrays.sort(nums, 0, nums.length - ans);
        
        return nums.length - ans;
    }
}
