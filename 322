class Solution {

    public int solve(int i, int[] coins, int amount, int[][] dp) {

        if (i == 0) {
            if (amount % coins[0] == 0) {
                return amount / coins[0];
            }
            return (int)1e9;
        }

        if (dp[i][amount] != -1) {
            return dp[i][amount];
        }

        int nt = solve(i - 1, coins, amount, dp);

        int take = (int)1e9;

        if (coins[i] <= amount) {
            take = 1 + solve(i, coins, amount - coins[i], dp);
        }

        return dp[i][amount] = Math.min(take, nt);
    }

    public int coinChange(int[] coins, int amount) {

        int n = coins.length;

        int[][] dp = new int[n][amount + 1];

        for (int[] row : dp) {
            Arrays.fill(row, -1);
        }

        int ans = solve(n - 1, coins, amount, dp);

        return ans >= (int)1e9 ? -1 : ans;
    }
}
