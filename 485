class Solution {
    public int findMaxConsecutiveOnes(int[] nums) {
        int m = nums.length;
        int max = 0;
        int k = 0;
        for( int i=0;i<m;i++){
            if(nums[i]==1){
                k = k+1;
            }
            if(nums[i]==0){
                k = 0;
                if(max<=k){
                    max = k;
                  

                }
            }
            if(max<=k){
                max = k;
            }

        }
        return max;



    
    
    }
}
