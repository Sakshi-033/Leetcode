class Solution {
    public int solve(int i, int[] coins, int amount, int[][] dp) {
       
        if (i == 0) {
            if (amount % coins[0] == 0) {
                return 1; 
            } else {
                return 0; 
            }
        }

        if (dp[i][amount] != -1) {
            return dp[i][amount];
        }

        
        int notTake = solve(i - 1, coins, amount, dp);

       
        int take = 0;
        if (coins[i] <= amount) {
            take = solve(i, coins, amount - coins[i], dp);
        }

       
        dp[i][amount] = take + notTake;
        return dp[i][amount];
    }

    public int change(int amount, int[] coins) {
        int n = coins.length;
        int[][] dp = new int[n][amount + 1];

        for (int[] row : dp) {
            Arrays.fill(row, -1);
        }

        return solve(n - 1, coins, amount, dp);
    }
}
