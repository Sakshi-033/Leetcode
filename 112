class Solution {

    public int add(TreeNode root, int targetSum) {

        if(root == null) return 0;

        
        if(root.left == null && root.right == null) {
            return root.val == targetSum ? 1 : 0;
        }

        int remaining = targetSum - root.val;

        int left = add(root.left, remaining);
        int right = add(root.right, remaining);

        if(left == 1 || right == 1) {
            return 1;
        }

        return 0;
    }

    public boolean hasPathSum(TreeNode root, int targetSum) {
        return add(root, targetSum) == 1;
    }
}
