class Solution {
    public int calc(int n, int[] ans) {
        if (n == 1) {
            return ans[n] = 1;
        }
        if (n == 2) {
            return ans[n] = 2;
        }
        if (ans[n] != -1) {
            return ans[n];
        }

        
        return ans[n] = calc(n - 1, ans) + calc(n - 2, ans);
    }

    public int climbStairs(int n) {
       
        int[] ans = new int[n + 1];
        Arrays.fill(ans, -1);
        
       
        int m = calc(n, ans);
        return m;
    }
}
